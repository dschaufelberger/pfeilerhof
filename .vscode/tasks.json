{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve",
      "type": "shell",
      "command": "bundle",
      "args": [
        "exec",
        "jekyll",
        "serve",
        "--livereload",
      ],
      "options": {
        "cwd": "${workspaceFolder}/Pfeilerhof"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "command": "bundle",
      "args": [
        "exec",
        "jekyll",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Pfeilerhof"
      },
      "dependsOn": [
        "clean"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "jekyll",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Pfeilerhof"
      },
      "problemMatcher": []
    },
    {
      "label": "Add page",
      "type": "shell",
      "command": "bundle",
      "args": [
        "exec",
        "jekyll",
        "page",
        "${input:pageName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Pfeilerhof"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "pageName",
      "description": "Name of the page",
      "type": "promptString"
    }
  ]
}