{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "serve",
            "type": "shell",
            "command": "bundle",
            "args": [
                "exec",
                "jekyll",
                "serve",
                "--livereload"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Pfeilerhof"
            },
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "bundle",
            "args": [
                "exec",
                "jekyll",
                "build",
            ],
            "options": {
                "cwd": "${workspaceFolder}/Pfeilerhof"
            },
            "dependsOn": [
                "clean"
            ],
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "jekyll",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Pfeilerhof"
            },
            "problemMatcher": []
        }
    ]
}